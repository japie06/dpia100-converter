*.ps1 text eol=crlf
*.bat text eol=crlf
*.md  text eol=crlf
*.pdf binary
# Test fixtures are exact bytes (encodings, BOMs, CRLF): never convert them.
tests/cases/** -text
# Example input shipped in the release zip: exact bytes (Windows-1252, CRLF).
voorbeeld.csv -text
# The web page and its test scripts. The CSP hashes in dpia100.html are computed over LF-normalized text
# (as the HTML parser sees it), so the line endings of a checkout do not matter.
*.html text eol=crlf
*.js   text eol=crlf
*.mjs  text eol=crlf
# Demo CSVs (every message, tests/demo): exact bytes.
tests/demo/*.csv -text
# Synthetic rubriek export and expected CSVs: exact bytes.
tests/rubrieken/** -text
